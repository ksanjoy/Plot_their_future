generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  HOST
  CO_HOST
  LEAD
  VENUE
}

enum GuestCohort {
  CLOSE_FAMILY
  FAMILY
  FRIENDS
  COLLEAGUES
  VIP
  OTHER
}

enum TileStatus {
  OPEN
  HOLD
  FUNDED
}

enum ContributionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  REFUND_REQUIRED
}

enum RsvpStatus {
  ATTENDING
  DECLINED
  MAYBE
}

enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum StageDisplayMode {
  NAMES_AND_BLESSINGS
  ANONYMIZED
  PROGRESS_ONLY
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum SettlementStatus {
  REQUESTED
  HOST_APPROVED
  APPROVED
  DISBURSED
  REJECTED
}

enum SettlementDestination {
  BUILDER_ESCROW
  HOME_LOAN
}

enum LedgerType {
  CREDIT
  DEBIT
  REFUND
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  phone           String   @unique
  name            String?
  email           String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions      Session[]
  memberships   WeddingMember[]
  invitations   Invitation[]
  contributions Contribution[]
  blessings     Blessing[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wedding {
  id                  String           @id @default(uuid()) @db.Uuid
  slug                String           @unique
  brideName           String
  groomName           String
  welcomeNote         String?
  videoInviteUrl      String?
  coverPhotoUrl       String?
  city                String?
  weddingDate         DateTime?
  timezone            String           @default("Asia/Kolkata")
  propertyName        String?
  propertyLocation    String?
  totalSft            Int
  ratePerSftPaise     Int
  presetTiers         Int[]            @default([1, 5, 10])
  cartHoldTtlSec      Int              @default(600)
  reraRegId           String?
  escrowBankName      String?
  escrowAccountNumber String?
  escrowIfsc          String?
  taxExemptionEnabled Boolean          @default(true)
  stageDisplayMode    StageDisplayMode @default(NAMES_AND_BLESSINGS)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  members       WeddingMember[]
  ceremonies    Ceremony[]
  invitations   Invitation[]
  rsvps         Rsvp[]
  rooms         RoomZone[]
  tiles         FloorTile[]
  contributions Contribution[]
  ledger        LedgerEntry[]
  settlements   Settlement[]
  blessings     Blessing[]
  dispatches    Dispatch[]
}

model WeddingMember {
  id        String     @id @default(uuid()) @db.Uuid
  weddingId String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole
  label     String?
  createdAt DateTime   @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weddingId, userId])
}

model Ceremony {
  id           String    @id @default(uuid()) @db.Uuid
  weddingId    String    @db.Uuid
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime?
  venueName    String
  venueAddress String?
  venueMapsUrl String?
  streamUrl    String?
  dressCode    String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wedding     Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invitations InvitationCeremony[]

  @@index([weddingId, startsAt])
}

model Invitation {
  id             String      @id @default(uuid()) @db.Uuid
  weddingId      String      @db.Uuid
  guestName      String
  phone          String
  email          String?
  cohort         GuestCohort @default(FAMILY)
  maxAttendees   Int         @default(2)
  enableRegistry Boolean     @default(true)
  refToken       String      @unique
  refLead        String?
  userId         String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  wedding          Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  ceremonies       InvitationCeremony[]
  rsvp             Rsvp?
  dispatchMessages DispatchMessage[]

  @@unique([weddingId, phone])
  @@index([phone])
}

model InvitationCeremony {
  invitationId String @db.Uuid
  ceremonyId   String @db.Uuid

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  ceremony   Ceremony   @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)

  @@id([invitationId, ceremonyId])
}

model Rsvp {
  id                   String     @id @default(uuid()) @db.Uuid
  weddingId            String     @db.Uuid
  invitationId         String     @unique @db.Uuid
  status               RsvpStatus
  adults               Int        @default(1)
  children             Int        @default(0)
  infants              Int        @default(0)
  attendingCeremonyIds String[]   @db.Uuid
  dietary              String[]
  allergies            String?
  arrivalMode          String?
  arrivalDetails       String?
  arrivalAt            DateTime?
  needsAccommodation   Boolean    @default(false)
  checkInDate          DateTime?  @db.Date
  checkOutDate         DateTime?  @db.Date
  needsShuttle         Boolean    @default(false)
  note                 String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  wedding    Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([weddingId, status])
}

model RoomZone {
  id          String  @id @default(uuid()) @db.Uuid
  weddingId   String  @db.Uuid
  key         String
  name        String
  description String?
  icon        String?
  sft         Int
  sortOrder   Int     @default(0)

  wedding       Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  tiles         FloorTile[]
  contributions Contribution[]

  @@unique([weddingId, key])
}

model FloorTile {
  id             String     @id @default(uuid()) @db.Uuid
  weddingId      String     @db.Uuid
  roomId         String     @db.Uuid
  index          Int
  status         TileStatus @default(OPEN)
  lockedUntil    DateTime?
  contributionId String?    @db.Uuid

  wedding      Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  room         RoomZone      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  @@unique([weddingId, index])
  @@index([weddingId, status])
  @@index([roomId, status])
  @@index([contributionId])
}

model Contribution {
  id                String             @id @default(uuid()) @db.Uuid
  weddingId         String             @db.Uuid
  userId            String?            @db.Uuid
  roomId            String             @db.Uuid
  units             Int
  ratePaise         Int
  amountPaise       Int
  donorName         String
  donorPhone        String?
  relationship      String?
  blessing          String?
  anonymous         Boolean            @default(false)
  tableNumber       String?
  refLead           String?
  status            ContributionStatus @default(PENDING)
  provider          String
  providerOrderId   String?            @unique
  providerPaymentId String?
  holdExpiresAt     DateTime
  paidAt            DateTime?
  failureReason     String?
  receiptNumber     String?            @unique
  receiptHash       String?
  receiptSignature  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  wedding Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  room    RoomZone      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tiles   FloorTile[]
  ledger  LedgerEntry[]

  @@index([weddingId, status])
  @@index([userId])
}

model LedgerEntry {
  id             String     @id @default(uuid()) @db.Uuid
  weddingId      String     @db.Uuid
  contributionId String?    @db.Uuid
  settlementId   String?    @db.Uuid
  type           LedgerType
  amountPaise    Int
  reference      String
  createdAt      DateTime   @default(now())

  wedding      Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  settlement   Settlement?   @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([weddingId, createdAt])
}

model Settlement {
  id                     String                @id @default(uuid()) @db.Uuid
  weddingId              String                @db.Uuid
  amountPaise            Int
  destination            SettlementDestination
  beneficiaryName        String
  accountNumber          String
  ifsc                   String
  status                 SettlementStatus      @default(REQUESTED)
  requestedById          String                @db.Uuid
  hostApprovedById       String?               @db.Uuid
  hostApprovedAt         DateTime?
  hostSignature          String?
  complianceApprovedById String?               @db.Uuid
  complianceApprovedAt   DateTime?
  complianceSignature    String?
  rejectedReason         String?
  bankReference          String?
  disbursedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  wedding Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  ledger  LedgerEntry[]

  @@index([weddingId, status])
}

model Blessing {
  id          String           @id @default(uuid()) @db.Uuid
  weddingId   String           @db.Uuid
  userId      String?          @db.Uuid
  authorName  String
  message     String?
  photoKey    String?
  tableNumber String?
  status      ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([weddingId, status, createdAt])
}

model Dispatch {
  id              String      @id @default(uuid()) @db.Uuid
  weddingId       String      @db.Uuid
  createdById     String      @db.Uuid
  ceremonyIds     String[]    @db.Uuid
  cohorts         GuestCohort[]
  refLead         String?
  includeRegistry Boolean     @default(true)
  total           Int         @default(0)
  createdAt       DateTime    @default(now())

  wedding  Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  messages DispatchMessage[]

  @@index([weddingId, createdAt])
}

model DispatchMessage {
  id                String         @id @default(uuid()) @db.Uuid
  dispatchId        String         @db.Uuid
  invitationId      String         @db.Uuid
  status            DeliveryStatus @default(QUEUED)
  error             String?
  providerMessageId String?
  sentAt            DateTime?

  dispatch   Dispatch   @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([dispatchId, status])
}

model NotificationLog {
  id                String         @id @default(uuid()) @db.Uuid
  channel           String
  recipient         String
  template          String
  payload           Json
  status            DeliveryStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime       @default(now())

  @@index([recipient, createdAt])
}

model PaymentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  eventId   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}
