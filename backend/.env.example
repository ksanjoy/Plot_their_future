# ---------------------------------------------------------------------------
# Plot Their Future API - environment variables
# Copy to .env and adjust. Every variable is validated at startup
# (src/config/env.ts); the app refuses to boot with an invalid value.
# Never commit .env. Do not put a real Atlas password in this file.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
JWT_SECRET=your_jwt_secret

# Public URL of this API (used in links sent to guests, e.g. receipt downloads)
API_PUBLIC_URL=http://localhost:5000
# Public URL of the Next.js web app (guest microsite, checkout, admin console)
WEB_PUBLIC_URL=http://localhost:3000
# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind a load balancer / reverse proxy
TRUST_PROXY=0

REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# JWT_SECRET is required at boot. Access tokens and signed links use the two
# secrets below (32+ random characters each). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_LINK_SECRET=change-me-link-secret-change-me-link-secret-0000
OTP_PEPPER=change-me-otp-pepper-change-me-otp-pepper-000000
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
# Comma separated E.164 numbers that become platform compliance officers on login
PLATFORM_ADMIN_PHONES=+919000000099
# Default country used to normalise phone numbers entered without a prefix
DEFAULT_PHONE_COUNTRY=IN

# --- Messaging ----------------------------------------------------------------
# console = log messages and store them in NotificationLog (development)
# cloud   = Meta WhatsApp Business Cloud API
WHATSAPP_DRIVER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_OTP=ptf_otp
WHATSAPP_TEMPLATE_INVITE=ptf_invite
WHATSAPP_TEMPLATE_RSVP=ptf_rsvp_confirmation
WHATSAPP_TEMPLATE_RECEIPT=ptf_gift_receipt
WHATSAPP_TEMPLATE_REMINDER=ptf_ceremony_reminder
# console = log only, msg91 = MSG91 OTP API (SMS fallback for OTP)
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Return the OTP in the API response. Only honoured when NODE_ENV != production.
EXPOSE_DEV_OTP=1

# --- Payments -----------------------------------------------------------------
# mock     = built-in simulator (development / demos, never in production)
# razorpay = Razorpay Orders + Checkout + webhooks (UPI, cards, netbanking)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Receipts -----------------------------------------------------------------
RECEIPT_SIGNING_SECRET=change-me-receipt-secret-change-me-receipt-000
RECEIPT_ISSUER_NAME=PlotTheirFuture.in

# --- File storage -------------------------------------------------------------
# local = ./uploads served by GET /api/v1/media/*, s3 = any S3 compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for uploaded objects (CloudFront / R2 public bucket URL)
S3_PUBLIC_URL=
MAX_UPLOAD_MB=8

# --- Workers ------------------------------------------------------------------
# Run BullMQ workers (receipts, broadcasts, reminders) inside this process
RUN_WORKERS=1
